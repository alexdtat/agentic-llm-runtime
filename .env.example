# Export a random token, or copy this file to .env and replace the placeholder.
PROBE_TOKEN=replace-with-a-random-local-token
RUNTIME_PORT=8080
# Default is a deterministic infrastructure mock, not an assistant or benchmark.
MODEL_BACKEND=mock
# Opt-in external API; never reads ~/.config/hyperqwen or starts a model.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
