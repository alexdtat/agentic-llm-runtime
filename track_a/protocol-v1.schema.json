{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client task contract v1",
  "$defs": {
    "create_task": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [
        "request_id",
        "message"
      ],
      "additionalProperties": false
    },
    "empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "failed",
            "cancelled"
          ]
        },
        "error_kind": {
          "enum": [
            null,
            "model",
            "transport",
            "timeout",
            "sandbox",
            "cancelled",
            "interrupted",
            "cleanup_failed",
            "step_limit",
            "context_limit"
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "error_kind",
        "answer"
      ],
      "additionalProperties": false
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "started"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "time": {
              "type": "number"
            },
            "task_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            }
          },
          "required": [
            "type",
            "sequence",
            "time",
            "task_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "model"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "time": {
              "type": "number"
            },
            "task_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            },
            "seconds": {
              "type": "number",
              "minimum": 0
            },
            "usage": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "backend": {
              "enum": [
                "mock",
                "openai-compatible"
              ]
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "sequence",
            "time",
            "task_id",
            "seconds",
            "usage",
            "backend",
            "content"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tool_started"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "time": {
              "type": "number"
            },
            "task_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "string",
                "pattern": "^[^\\u0000]*$"
              }
            }
          },
          "required": [
            "type",
            "sequence",
            "time",
            "task_id",
            "run_id",
            "argv"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tool_result"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "time": {
              "type": "number"
            },
            "task_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            },
            "result": {
              "$ref": "#/$defs/command_result"
            }
          },
          "required": [
            "type",
            "sequence",
            "time",
            "task_id",
            "run_id",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "result"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "time": {
              "type": "number"
            },
            "task_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            },
            "status": {
              "enum": [
                "complete",
                "failed",
                "cancelled"
              ]
            },
            "error_kind": {
              "enum": [
                null,
                "model",
                "transport",
                "timeout",
                "sandbox",
                "cancelled",
                "interrupted",
                "cleanup_failed",
                "step_limit",
                "context_limit"
              ]
            },
            "answer": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "sequence",
            "time",
            "task_id",
            "status",
            "error_kind",
            "answer"
          ],
          "additionalProperties": false
        }
      ]
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "request": {
          "$ref": "#/$defs/create_task"
        },
        "status": {
          "enum": [
            "running",
            "complete",
            "failed",
            "cancelled"
          ]
        },
        "result": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/result"
            }
          ]
        },
        "model_backend": {
          "enum": [
            "mock",
            "openai-compatible"
          ]
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      },
      "required": [
        "id",
        "session_id",
        "request",
        "status",
        "result",
        "model_backend",
        "events"
      ],
      "additionalProperties": false
    },
    "command_result": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "failed",
            "cancelled",
            "timed_out"
          ]
        },
        "error_kind": {
          "enum": [
            null,
            "command",
            "timeout",
            "cancelled",
            "transport",
            "sandbox",
            "interrupted",
            "cleanup_failed"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "error_kind",
        "exit_code",
        "stdout",
        "stderr"
      ],
      "additionalProperties": false
    }
  }
}
