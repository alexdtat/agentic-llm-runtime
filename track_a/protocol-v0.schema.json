{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executor command contract v0, CPU-v1 cancellation semantics",
  "$defs": {
    "create_session": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        }
      },
      "required": [
        "request_id"
      ],
      "additionalProperties": false
    },
    "create_run": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]*$"
          }
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 10
        }
      },
      "required": [
        "request_id",
        "argv",
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "container": {
          "type": "string"
        },
        "status": {
          "enum": [
            "provisioning",
            "open",
            "closing",
            "closed",
            "cleanup_failed"
          ]
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        }
      },
      "required": [
        "id",
        "container",
        "status",
        "request_id"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "failed",
            "cancelled",
            "timed_out"
          ]
        },
        "error_kind": {
          "enum": [
            null,
            "command",
            "timeout",
            "cancelled",
            "transport",
            "sandbox",
            "interrupted",
            "cleanup_failed"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "error_kind",
        "exit_code",
        "stdout",
        "stderr"
      ],
      "additionalProperties": false
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "started"
            },
            "sequence": {
              "const": 0
            }
          },
          "required": [
            "type",
            "sequence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "result"
            },
            "sequence": {
              "const": 1
            },
            "status": {
              "enum": [
                "complete",
                "failed",
                "cancelled",
                "timed_out"
              ]
            },
            "error_kind": {
              "enum": [
                null,
                "command",
                "timeout",
                "cancelled",
                "transport",
                "sandbox",
                "interrupted",
                "cleanup_failed"
              ]
            },
            "exit_code": {
              "type": [
                "integer",
                "null"
              ]
            },
            "stdout": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "sequence",
            "status",
            "error_kind",
            "exit_code",
            "stdout",
            "stderr"
          ],
          "additionalProperties": false
        }
      ]
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "status": {
          "enum": [
            "running",
            "complete",
            "failed",
            "cancelled",
            "timed_out"
          ]
        },
        "request": {
          "$ref": "#/$defs/create_run"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "result": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/result"
            }
          ]
        }
      },
      "required": [
        "id",
        "session_id",
        "status",
        "request",
        "events",
        "result"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  }
}
