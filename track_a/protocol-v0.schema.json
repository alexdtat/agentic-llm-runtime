{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A diagnostic v0 request payloads",
  "$defs": {
    "create_session": {
      "type": "object",
      "required": ["request_id"],
      "properties": {"request_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"}},
      "additionalProperties": false
    },
    "create_run": {
      "type": "object",
      "required": ["request_id", "argv", "timeout_seconds"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"},
        "argv": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string"}},
        "timeout_seconds": {"type": "number", "minimum": 0.05, "maximum": 10}
      },
      "additionalProperties": false
    }
  }
}
